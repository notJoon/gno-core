loadpkg gno.land/p/demo/tokens/grc721
loadpkg gno.land/r/test/grc721registry $WORK/registry
loadpkg gno.land/r/test/grc721victim $WORK/victim
loadpkg gno.land/r/test/grc721attacker $WORK/attacker

gnoland start

gnokey query vm/qeval --data 'gno.land/r/test/grc721victim.Snapshot()'
stdout 'g1jg8mtutu9khhfwc4nxmuhcpftf0pajdhfvsqf5:original'

gnokey maketx call -pkgpath gno.land/r/test/grc721attacker -func AssertSafe -gas-fee 5000001ugnot -gas-wanted 50_000_000 -chainid=tendermint_test test1
stdout 'OK!'

! gnokey maketx call -pkgpath gno.land/r/test/grc721attacker -func AttackMetadata -gas-fee 5000001ugnot -gas-wanted 50_000_000 -chainid=tendermint_test test1
stderr 'cannot directly modify readonly tainted object'

! gnokey maketx call -pkgpath gno.land/r/test/grc721attacker -func SpoofRealm -gas-fee 5000001ugnot -gas-wanted 50_000_000 -chainid=tendermint_test test1
stderr 'rlm does not match the current crossing frame'

! gnokey maketx call -pkgpath gno.land/r/test/grc721victim -func RegisterAgain -gas-fee 5000001ugnot -gas-wanted 50_000_000 -chainid=tendermint_test test1
stderr 'collection already registered'

! gnokey maketx call -pkgpath gno.land/r/test/grc721attacker -func RegisterNil -gas-fee 5000001ugnot -gas-wanted 50_000_000 -chainid=tendermint_test test1
stderr 'nil collection reader'

! gnokey maketx call -pkgpath gno.land/r/test/grc721attacker -func RegisterInvalid -gas-fee 5000001ugnot -gas-wanted 50_000_000 -chainid=tendermint_test test1
stderr 'invalid collection name'

gnokey query vm/qeval --data 'gno.land/r/test/grc721victim.Snapshot()'
stdout 'g1jg8mtutu9khhfwc4nxmuhcpftf0pajdhfvsqf5:original'

-- registry/gnomod.toml --
module = "gno.land/r/test/grc721registry"
gno = "0.9"

-- registry/registry.gno --
package grc721registry

import (
	"gno.land/p/demo/tokens/grc721"
	"gno.land/p/nt/avl/v0"
)

var readers = avl.NewTree()

func Register(cur realm, reader grc721.IGRC721Reader) {
	if !cur.IsCurrent() {
		panic(grc721.ErrSpoofedRealm)
	}
	realmPath := cur.Previous().PkgPath()
	if realmPath == "" {
		panic("collection must be registered by a realm")
	}
	if reader == nil {
		panic("nil collection reader")
	}
	if !validName(reader.Name()) {
		panic("invalid collection name")
	}
	symbol := reader.Symbol()
	if !validSymbol(symbol) {
		panic("invalid collection symbol")
	}
	key := realmPath + "." + symbol
	if reader.ID() != key {
		panic("collection ID does not match caller")
	}
	if readers.Has(key) {
		panic("collection already registered")
	}
	readers.Set(key, reader)
}

func Get(key string) grc721.IGRC721Reader {
	value := readers.Get(key)
	if value == nil {
		panic("collection not found")
	}
	return value.(grc721.IGRC721Reader)
}

func validName(name string) bool {
	if name == "" || len(name) > grc721.MaxNameLen {
		return false
	}
	for _, c := range name {
		if c < 0x20 || c == 0x7f {
			return false
		}
	}
	return true
}

func validSymbol(symbol string) bool {
	if symbol == "" || len(symbol) > grc721.MaxSymbolLen {
		return false
	}
	for _, c := range symbol {
		if !isAlnum(c) && c != '_' && c != '-' {
			return false
		}
	}
	return true
}

func isAlnum(c rune) bool {
	return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')
}

-- victim/gnomod.toml --
module = "gno.land/r/test/grc721victim"
gno = "0.9"

-- victim/victim.gno --
package grc721victim

import (
	"gno.land/p/demo/tokens/grc721"
	"gno.land/r/test/grc721registry"
)

const tokenID = grc721.TokenID("one")

var (
	owner  address = "g1jg8mtutu9khhfwc4nxmuhcpftf0pajdhfvsqf5"
	reader grc721.IGRC721Reader
	ledger *grc721.RoyaltyLedger
)

func init(cur realm) {
	public, private := grc721.NewNFTWithRoyalty("Victim NFT", "VNFT", cur)
	reader = public
	ledger = private
	if err := ledger.Mint(owner, tokenID); err != nil {
		panic(err)
	}
	if err := ledger.SetTokenMetadata(tokenID, grc721.Metadata{
		Name:       "victim",
		Attributes: []grc721.Trait{{TraitType: "status", Value: "original"}},
	}); err != nil {
		panic(err)
	}
	grc721registry.Register(cross(cur), reader)
}

func Reader() grc721.IGRC721Reader {
	return reader
}

func RegisterAgain(cur realm) {
	if !cur.IsCurrent() {
		panic(grc721.ErrSpoofedRealm)
	}
	grc721registry.Register(cross(cur), reader)
}

func Snapshot() string {
	tokenOwner, err := reader.OwnerOf(tokenID)
	if err != nil {
		panic(err)
	}
	metadata, err := reader.(grc721.IGRC721MetadataOnchain).TokenMetadata(tokenID)
	if err != nil {
		panic(err)
	}
	return tokenOwner.String() + ":" + metadata.Attributes[0].Value
}

-- attacker/gnomod.toml --
module = "gno.land/r/test/grc721attacker"
gno = "0.9"

-- attacker/attacker.gno --
package grc721attacker

import (
	"gno.land/p/demo/tokens/grc721"
	"gno.land/r/test/grc721registry"
	"gno.land/r/test/grc721victim"
)

type mintMutator interface {
	Mint(to address, tid grc721.TokenID) error
}

type burnMutator interface {
	Burn(tid grc721.TokenID) error
}

type approveMutator interface {
	Approve(caller, to address, tid grc721.TokenID) error
}

type approvalForAllMutator interface {
	SetApprovalForAll(caller, operator address, approved bool) error
}

type transferMutator interface {
	TransferFrom(caller, from, to address, tid grc721.TokenID) error
}

type tokenURIMutator interface {
	SetTokenURI(tid grc721.TokenID, uri grc721.TokenURI) error
}

type metadataMutator interface {
	SetTokenMetadata(tid grc721.TokenID, metadata grc721.Metadata) error
}

type royaltyMutator interface {
	SetTokenRoyalty(tid grc721.TokenID, royalty grc721.RoyaltyInfo) error
}

type invalidReader struct{}

func (invalidReader) ID() string { return "gno.land/r/test/grc721attacker.BAD" }
func (invalidReader) Name() string { return "" }
func (invalidReader) Symbol() string { return "BAD" }
func (invalidReader) TokenCount() int64 { return 0 }
func (invalidReader) BalanceOf(address) (int64, error) { return 0, nil }
func (invalidReader) OwnerOf(grc721.TokenID) (address, error) { return "", nil }
func (invalidReader) GetApproved(grc721.TokenID) (address, error) { return "", nil }
func (invalidReader) IsApprovedForAll(address, address) bool { return false }

func hasMutator(reader grc721.IGRC721Reader) bool {
	_, mint := reader.(mintMutator)
	_, burn := reader.(burnMutator)
	_, approve := reader.(approveMutator)
	_, approvalForAll := reader.(approvalForAllMutator)
	_, transfer := reader.(transferMutator)
	_, tokenURI := reader.(tokenURIMutator)
	_, metadata := reader.(metadataMutator)
	_, royalty := reader.(royaltyMutator)
	return mint || burn || approve || approvalForAll || transfer || tokenURI || metadata || royalty
}

func AssertSafe(cur realm) {
	if !cur.IsCurrent() {
		panic(grc721.ErrSpoofedRealm)
	}

	direct := grc721victim.Reader()
	if hasMutator(direct) {
		panic("direct reader exposes mutation")
	}

	concrete, ok := direct.(*grc721.RoyaltyNFT)
	if !ok {
		panic("concrete public type was lost")
	}
	_ = concrete

	registered := grc721registry.Get(direct.ID())
	if hasMutator(registered) {
		panic("registered reader exposes mutation")
	}
	if _, ok := registered.(grc721.IGRC721MetadataOnchain); !ok {
		panic("registered reader lost metadata")
	}
	if _, ok := registered.(grc721.IGRC2981); !ok {
		panic("registered reader lost royalty")
	}
}

func AttackMetadata(cur realm) {
	if !cur.IsCurrent() {
		panic(grc721.ErrSpoofedRealm)
	}
	registered := grc721registry.Get(grc721victim.Reader().ID())
	metadataReader := registered.(grc721.IGRC721MetadataOnchain)
	metadata, err := metadataReader.TokenMetadata("one")
	if err != nil {
		panic(err)
	}
	metadata.Attributes[0].Value = "attacked"
}

func SpoofRealm(cur realm) {
	if !cur.IsCurrent() {
		panic(grc721.ErrSpoofedRealm)
	}
	grc721.NewBasicNFT("Fake", "FAKE", cur.Previous())
}

func RegisterNil(cur realm) {
	if !cur.IsCurrent() {
		panic(grc721.ErrSpoofedRealm)
	}
	grc721registry.Register(cross(cur), nil)
}

func RegisterInvalid(cur realm) {
	if !cur.IsCurrent() {
		panic(grc721.ErrSpoofedRealm)
	}
	grc721registry.Register(cross(cur), invalidReader{})
}
